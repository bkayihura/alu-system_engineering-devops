#!/usr/bin/env bash
# Configure Nginx to run as nginx on port 8080
service nginx stop
pkill -x nginx 2>/dev/null || true
id nginx >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin nginx
sed -i -e "s/listen 80 default_server/listen 8080 default_server/" -e "s/listen .::.:80 default_server/listen [::]:8080 default_server/" /etc/nginx/sites-enabled/default
sed -i -e "s/^user www-data;/user nginx;/" -e "s#pid /run/nginx.pid;#pid /tmp/nginx.pid;#" /etc/nginx/nginx.conf
chown -R nginx:nginx /var/log/nginx /var/lib/nginx
rm -f /tmp/nginx.pid
su -s /bin/sh nginx -c "/usr/sbin/nginx"
