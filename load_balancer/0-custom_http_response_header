#!/usr/bin/env bash
# Installs nginx and adds an X-Served-By header with the server hostname
# shellcheck disable=SC2154
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html
echo "Holberton School for the win!" > /var/www/html/index.html
sed -i "s|server_name _;|server_name _;\n\n\tadd_header X-Served-By \$hostname;|" /etc/nginx/sites-enabled/default
service nginx restart
